# Скопируйте в .env и заполните. Файл .env в репозиторий не попадает.

# Обязателен в production. Сгенерировать:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# По умолчанию — SQLite в instance/. Для production, например:
#   postgresql+psycopg2://user:password@localhost:5432/projectscloud
DATABASE_URI=sqlite:///database.sqlite

# production включает строгие настройки куки и требует SECRET_KEY
FLASK_ENV=development
